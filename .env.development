# Environment: Development
# Description: Environment variables for the development environment.
# Note: Do not commit sensitive information to version control.
# VITE_VITALITA_API_URL points to json-server (port 3000). Change it to the Vitalita API URL when the C# backend is running.
VITE_VITALITA_API_URL="http://localhost:3000/api/v1"
# Identity and Access Management
VITE_USERS_ENDPOINT_PATH="/users"
# Profiles Management
VITE_CAREGIVER_PROFILES_ENDPOINT_PATH="/caregiver-profiles"
VITE_FAMILY_MEMBER_PROFILES_ENDPOINT_PATH="/family-member-profiles"
VITE_OLDER_ADULTS_ENDPOINT_PATH="/older-adults"
VITE_FAMILY_ACCESS_ENDPOINT_PATH="/family-access"
# Service Execution and Monitoring
VITE_DAILY_REPORTS_ENDPOINT_PATH="/daily-reports"
VITE_VITAL_SIGNS_ENDPOINT_PATH="/vital-signs"
VITE_MEDICATIONS_ENDPOINT_PATH="/medications"
VITE_MEDICATION_ADMINISTRATIONS_ENDPOINT_PATH="/medication-administrations"
VITE_MEDICAL_APPOINTMENTS_ENDPOINT_PATH="/medical-appointments"
VITE_MEDICAL_EXAMS_ENDPOINT_PATH="/medical-exams"
VITE_CARE_ACTIVITIES_ENDPOINT_PATH="/care-activities"
# Resource and Asset Management
VITE_CLINICAL_ASSETS_ENDPOINT_PATH="/clinical-assets"
VITE_EXAM_EVIDENCES_ENDPOINT_PATH="/exam-evidences"
VITE_EMERGENCY_REPORTS_ENDPOINT_PATH="/emergency-reports"
# Service Design and Planning
VITE_REMINDERS_ENDPOINT_PATH="/reminders"
VITE_NOTIFICATIONS_ENDPOINT_PATH="/notifications"
# Subscriptions and Payment Management
VITE_PLANS_ENDPOINT_PATH="/plans"
VITE_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"
VITE_PAYMENTS_ENDPOINT_PATH="/payments"
# Cloudinary (evidence photos). Use an unsigned upload preset. When empty, photos are saved as small data URLs for local demos.
VITE_CLOUDINARY_CLOUD_NAME="g195urb0"
VITE_CLOUDINARY_UPLOAD_PRESET="vitalita_evidences"
# Culqi public key (pk_test_...). The secret key must never be here: charges are made by the Vitalita API.
# When empty, a simulated gateway is used for demos.
VITE_CULQI_PUBLIC_KEY="pk_test_gaspL0EJKIrtOOMh"
# External links
VITE_LANDING_PAGE_URL="https://mobvite.github.io/langing-page"
# PrimeUI community license key. Get your own free key from your PrimeUI account.
VITE_PRIME_UI_LICENSE_KEY="eyJpZCI6IjA3Y2U4M2Q5LTAxMGItNDg3NS1iNjYwLTYwMDZhM2Y3NjU0YSIsInByb2R1Y3QiOiJwcmltZXVpIiwidGllciI6ImNvbW11bml0eSIsInR5cGUiOiJkZXYiLCJpYXQiOjE3OTAyMTE4MzAsImV4cCI6MTgyMTc0NzgzMH0.bQisf_sQ4uAMR9wRmU0GZdPImfwt9XYVSOyC_uCyldGcnENcJEZznaI1AAbYU3nINhKh32wsEsI2mIBNBJonDg"
